{
  "manifest_version": 3,
  "name": "Alltabs",
  "version": "0.1.0",
  "description": "Your synced Chrome tabs, one click away. Browse devices in a persistent side panel.",
  "minimum_chrome_version": "141",
  "permissions": ["sidePanel", "sessions", "tabs", "storage", "favicon", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Toggle Alltabs",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'" }
}
